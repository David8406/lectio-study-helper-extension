{
  "manifest_version": 3,
  "name": "Lectio Study Helper",
  "version": "1.0.0",
  "description": "Highlight web pages and PDFs, see word count and reading time, and get AI summaries and explanations.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://lectio-study-helper-extension.vercel.app/*"],
  "action": {
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}