{
  "manifest_version": 3,
  "name": "Lectio Study Helper Extension",
  "version": "1.0.0",
  "description": "A study helper extension.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}